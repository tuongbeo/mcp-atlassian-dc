# =============================================================================
# mcp-atlassian-dc — Environment Variables
# Jira / Confluence Data Center với OAuth 2.0
# =============================================================================

# ------------------------------------------------------------
# Bước 1: URLs (bắt buộc)
# ------------------------------------------------------------
JIRA_URL=https://jira.pila.vn
CONFLUENCE_URL=https://confluence.pila.vn

# ------------------------------------------------------------
# Bước 2: Chọn 1 trong 2 phương thức xác thực
# ------------------------------------------------------------

# --- Phương thức A: Personal Access Token (đơn giản hơn) ---
# Tạo PAT tại: Jira → Profile → Personal Access Tokens
# JIRA_PERSONAL_TOKEN=your_jira_pat_here
# CONFLUENCE_PERSONAL_TOKEN=your_confluence_pat_here

# --- Phương thức B: OAuth 2.0 (khuyến nghị cho production) ---
#
# Yêu cầu (Jira Admin thực hiện 1 lần):
#   1. Jira Admin Panel → Applications → Application Links
#   2. Create link → External application → Incoming
#   3. Đặt Redirect URL: http://localhost:8080/callback
#   4. Enable scopes: READ, WRITE
#   5. Copy Client ID + Client Secret
#
# Sau khi Admin setup Application Link, mỗi user chạy:
#   mcp-atlassian --dc-oauth-setup
#
ATLASSIAN_OAUTH_CLIENT_ID=your_client_id_here
ATLASSIAN_OAUTH_CLIENT_SECRET=your_client_secret_here
ATLASSIAN_OAUTH_REDIRECT_URI=http://localhost:8080/callback
ATLASSIAN_OAUTH_SCOPE=READ WRITE

# ------------------------------------------------------------
# Bước 3: Cấu hình tùy chọn
# ------------------------------------------------------------

# SSL (chỉ cần nếu dùng self-signed certificate)
# JIRA_SSL_VERIFY=false
# CONFLUENCE_SSL_VERIFY=false

# Transport cho Railway deployment
TRANSPORT=streamable-http
STATELESS=true
HOST=0.0.0.0

# Giới hạn công cụ hiển thị
# TOOLSETS=all

# Lọc project
# JIRA_PROJECTS_FILTER=PROJ1,PROJ2

# =============================================================================
# Hướng dẫn sử dụng OAuth 2.0
# =============================================================================
#
# 1. Chạy setup wizard (lần đầu, mỗi user):
#    mcp-atlassian --dc-oauth-setup
#
# 2. Start server:
#    mcp-atlassian --transport streamable-http --stateless
#
# 3. Verify tokens:
#    curl -H "Authorization: Bearer <access_token>" \
#         https://jira.pila.vn/rest/api/2/myself
#
# Token lifecycle:
#   - Access token:  ~2 giờ (tự refresh)
#   - Refresh token: dài hạn (lưu tại ~/.mcp-atlassian/oauth-<client_id>.json)
#   - Re-auth chỉ cần khi refresh token hết hạn hoặc bị revoke
#
